# ============================================================
# Environment Variables — PicchuSpot (Real Estate Visuals)
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- Supabase (REQUIRED for order system) ---
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Resend (property viewing-request email delivery) ---
# Resend is used for property viewing-request email delivery.
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here
# Verified "From" address for transactional email (order confirmations,
# admin alerts, property leads). Optional: falls back to
# orders@picchuspot.com when unset. Must belong to a domain verified
# in your Resend account.
FROM_EMAIL=orders@picchuspot.com
# Server-only internal outbox worker auth. Mirror the production value in
# Supabase Vault as picchuspot_order_email_worker_secret; never commit it.
CRON_SECRET=replace-with-a-strong-random-secret
PROPERTY_LEADS_FROM_EMAIL=leads@picchuspot.com
# Optional operations copy. The published property's realtor email remains the
# primary recipient; this variable never replaces it.
PROPERTY_LEADS_CC_EMAIL=

# --- Stripe (server-only secrets; use Stripe test/sandbox values in development) ---
# Never prefix these values with NEXT_PUBLIC_ or expose them to client components.
STRIPE_SECRET_KEY=sk_test_your-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# --- App Config ---
# Production: https://picchuspot.com
# Local dev:  http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://picchuspot.com

# Google Analytics 4 measurement ID (public, browser-side). Enables the
# GA page-view snippet in src/components/analytics/GoogleAnalytics.tsx.
# Leave empty to disable analytics tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Public form abuse protection ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Generate at least 32 random characters. May fall back to SUPPORT_RATE_LIMIT_SECRET.
PROPERTY_LEADS_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# --- Support assistant (optional; /dashboard support chat) ---
# Gemini API key for the AI support assistant
# (src/lib/support-assistant/gemini-transport.ts). Without it the support
# assistant stays unavailable; the rest of the site is unaffected.
# Get this from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# HMAC secret used to hash visitor identities before rate limiting the
# support assistant endpoint. At least 32 random characters; without it
# the support assistant API fails closed.
SUPPORT_RATE_LIMIT_SECRET=replace-with-a-long-random-secret

# Optional comma-separated exact HTTPS origins for approved custom video iframes.
PROPERTY_SHOWCASE_TRUSTED_VIDEO_ORIGINS=

# Optional comma-separated exact HTTPS origins for approved custom provider
# iframe embeds (property tours). Also feeds the CSP frame-src allowlist
# in src/lib/security-headers.ts. Not a secret.
PROPERTY_SHOWCASE_TRUSTED_FRAME_ORIGINS=

# Inbox that should receive order notifications and admin alerts.
# Recommended: orders@picchuspot.com (notifications) or hello@picchuspot.com (general).
ADMIN_EMAIL=orders@picchuspot.com

# --- Admin (REQUIRED for /admin/portfolio) ---
# Single shared password used by /admin/login. Treat this like any
# production secret — never commit it, never expose it to the client,
# and rotate it if it leaks. Changing this value invalidates every
# existing admin session cookie automatically.
ADMIN_PASSWORD=change-me
